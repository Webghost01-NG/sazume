{
  "name": "sazume-offchain-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/cli"],
  "scripts": {
    "test": "vitest run",
    "demo": "tsx demo/run.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "sazume": "tsx packages/cli/src/index.ts",
    "test:contracts": "forge test --root contracts",
    "test:contracts:arc": "arc-forge test --root contracts",
    "demo:arc-local": "forge build --root contracts && tsx packages/arc/src/demo-local.ts",
    "demo:arc-foundry-local": "SAZUME_ARC_FOUNDRY_LOCAL=1 tsx packages/arc/src/demo-local.ts",
    "qualify:arc-testnet:hero": "tsx packages/arc/src/qualify-testnet.ts hero",
    "qualify:arc-testnet:full": "tsx packages/arc/src/qualify-testnet.ts full"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
