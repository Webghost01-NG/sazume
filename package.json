{
  "name": "sazume-offchain-spike",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Economic reliability testing for programmable money.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Webghost01-NG/sazume.git"
  },
  "homepage": "https://sazume.vercel.app",
  "workspaces": ["packages/core", "packages/cli"],
  "scripts": {
    "prepare": "npm run build:packages",
    "test": "vitest run",
    "build:packages": "npm run build --workspace @sazume/core && npm run build --workspace @sazume/cli",
    "pretest": "npm run build:packages",
    "demo": "tsx demo/run.ts",
    "pretypecheck": "npm run build:packages",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "dev": "vite --config apps/web/vite.config.ts",
    "prebuild": "npm run build:packages",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:cli": "npm run build:packages",
    "test:external-consumer": "node scripts/verify-external-consumer.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "sazume": "node packages/cli/bin/sazume.js",
    "test:contracts": "forge test --root contracts",
    "test:contracts:arc": "arc-forge test --root contracts",
    "demo:arc-local": "forge build --root contracts && tsx packages/arc/src/demo-local.ts",
    "demo:arc-foundry-local": "SAZUME_ARC_FOUNDRY_LOCAL=1 tsx packages/arc/src/demo-local.ts",
    "qualify:arc-testnet:hero": "tsx packages/arc/src/qualify-testnet.ts hero",
    "qualify:arc-testnet:full": "tsx packages/arc/src/qualify-testnet.ts full",
    "preflight:arc-mainnet": "forge build --root contracts && tsx packages/arc/src/mainnet-readonly-preflight.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
