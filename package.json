{
  "name": "sazume-offchain-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "demo": "tsx demo/run.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "forge test --root contracts",
    "test:contracts:arc": "arc-forge test --root contracts",
    "demo:arc-local": "forge build --root contracts && tsx packages/arc/src/demo-local.ts",
    "demo:arc-foundry-local": "SAZUME_ARC_FOUNDRY_LOCAL=1 tsx packages/arc/src/demo-local.ts",
    "qualify:arc-testnet:hero": "tsx packages/arc/src/qualify-testnet.ts hero",
    "qualify:arc-testnet:full": "tsx packages/arc/src/qualify-testnet.ts full"
  },
  "dependencies": {
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
